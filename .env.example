# Local development only. Copy this file to .env before starting Docker.
APP_ENV=development
APP_VERSION=1.0.0
APP_UPDATE_COUNT=1
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-key-change-before-sharing
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=cash_flow
POSTGRES_USER=cash_flow
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# These local accounts are created only when DJANGO_DEBUG=true.
# Developer can access /system-admin/. Business Admin uses the normal application UI.
DEV_SUPERUSER_USERNAME=developer
DEV_SUPERUSER_PASSWORD=CashFlow-system-2026!
DEV_SUPERUSER_EMAIL=developer@example.test
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CashFlow-dev-2026!
APP_ADMIN_EMAIL=admin@example.test

